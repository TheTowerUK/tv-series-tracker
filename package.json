{
  "name": "tv-series-tracker-development",
  "version": "2.0.0",
  "private": true,
  "description": "Repository-local development tooling for TVSeriesTracker.",
  "scripts": {
    "test": "node scripts/run-node-tests.mjs",
    "build:pages": "node scripts/build-pages-artifact.mjs",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:browser-foundation": "node --test tests/browser-foundation/*.test.js",
    "test:auth": "node --test tests/auth/*.test.js",
    "test:repository": "node --test tests/repository/*.test.js",
    "test:cloud-export": "node --test tests/cloud-export/*.test.js",
    "test:cloud-mutations": "node --test tests/cloud-mutations/*.test.js",
    "test:migration-source": "node --test tests/migration-source/*.test.js",
    "test:migration-review": "node --test tests/migration-review/*.test.js",
    "test:migration-execution": "node --test tests/migration-execution/*.test.js",
    "test:tmdb": "node --test tests/tmdb/*.test.mjs"
  },
  "devDependencies": {
    "supabase": "2.114.0"
  },
  "engines": {
    "node": ">=20"
  }
}
